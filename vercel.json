{
  "headers": [
    {
      "source": "/sanity-api/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=5, stale-while-revalidate=30" }]
    }
  ],
  "rewrites": [
    { "source": "/sanity-api/:path*", "destination": "https://urj7gol0.api.sanity.io/:path*" },
    { "source": "/studio", "destination": "/studio/index.html" },
    { "source": "/studio/:path*", "destination": "/studio/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
